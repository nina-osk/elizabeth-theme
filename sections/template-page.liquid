<div style="background-color: #F5F1E8; width: 100%; min-height: 100vh;">
  <div style="margin: 0 auto; max-width: 56rem; padding: 4rem 1rem;">
    
    {% if page.title %}
      <h1 style="font-family: Georgia, serif; font-size: 3.5rem; font-weight: 400; color: #1a1a1a; margin-bottom: 3rem; text-align: left; letter-spacing: -0.5px; line-height: 1.1;">
        {{ page.title }}
      </h1>
    {% endif %}

    {% if page.content %}
      <div style="font-size: 1.0625rem; line-height: 1.8; color: #555; word-break: break-word;">
        {{ page.content }}
      </div>
    {% endif %}

  </div>
</div>

<style>
  h2 {
    font-size: 1.875rem;
    font-weight: 600;
    margin: 2rem 0 1rem;
    color: #1a1a1a;
    font-family: Georgia, serif;
  }

  h3 {
    font-size: 1.5rem;
    font-weight: 600;
    margin: 1.5rem 0 0.75rem;
    color: #1a1a1a;
    font-family: Georgia, serif;
  }

  a {
    color: #D4A574;
  }

  a:hover {
    color: #B89872;
  }

  ul, ol {
    margin-left: 2rem;
  }

  li {
    color: #555;
  }
</style>

{% schema %}
{
  "name": "Page Template",
  "settings": []
}
{% endschema %}
