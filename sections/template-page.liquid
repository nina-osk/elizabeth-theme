<div style="background-color: #F5F1E8 !important; width: 100% !important; padding: 2rem 1.5rem !important; min-height: calc(100vh - 400px) !important;" class="template-page-outer">
  <div style="margin: 0 auto; max-width: 56rem;">
    
    {% if page.title %}
      <h1 style="font-family: Georgia, serif; font-size: 2rem; font-weight: 400; color: #1a1a1a; margin-bottom: 2rem; text-align: left; letter-spacing: -0.5px; line-height: 1.1;">
        {{ page.title }}
      </h1>
    {% endif %}

    {% if page.content %}
      <div style="font-size: 1rem; line-height: 1.8; color: #555; word-break: break-word;">
        {{ page.content }}
      </div>
    {% endif %}

  </div>
</div>

<style>
  .template-page-outer {
    padding: 2rem 1.5rem !important;
  }

  @media (min-width: 640px) {
    .template-page-outer {
      padding: 3rem 2rem !important;
    }
  }

  @media (min-width: 768px) {
    .template-page-outer {
      padding: 4rem 4rem !important;
    }
  }

  @media (min-width: 1024px) {
    .template-page-outer {
      padding: 4rem 8rem !important;
    }
  }

  h1 {
    font-size: 1.875rem;
    margin-bottom: 2rem;
  }

  @media (min-width: 768px) {
    h1 {
      font-size: 3.5rem;
      margin-bottom: 3rem;
    }
  }

  h2 {
    font-size: 1.5rem;
    font-weight: 600;
    margin: 2rem 0 1rem;
    color: #1a1a1a;
    font-family: Georgia, serif;
  }

  @media (min-width: 768px) {
    h2 {
      font-size: 1.875rem;
    }
  }

  h3 {
    font-size: 1.25rem;
    font-weight: 600;
    margin: 1.5rem 0 0.75rem;
    color: #1a1a1a;
    font-family: Georgia, serif;
  }

  @media (min-width: 768px) {
    h3 {
      font-size: 1.5rem;
    }
  }

  p {
    margin-bottom: 1.25rem;
    line-height: 1.8;
  }

  a {
    color: #D4A574;
  }

  a:hover {
    color: #B89872;
  }

  ul, ol {
    margin-left: 1.5rem;
    margin-bottom: 1.25rem;
  }

  @media (min-width: 768px) {
    ul, ol {
      margin-left: 2rem;
    }
  }

  li {
    color: #555;
    margin-bottom: 0.75rem;
  }
</style>

{% schema %}
{
  "name": "Page Template",
  "settings": []
}
{% endschema %}
