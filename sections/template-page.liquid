<div style="background-color: #F5F1E8 !important; width: 100% !important; padding: 2rem 1.5rem !important; min-height: calc(100vh - 400px) !important;" class="template-page-outer">
  <div style="margin: 0 auto; max-width: 56rem;">
    
    {% if page.title %}
      <h1 class="page-title">{{ page.title }}</h1>
    {% endif %}

  {% if page.content %}
      <div style="font-size: 1rem; line-height: 1.8; color: #555; word-break: break-word; text-align: justify;">
        {{ page.content }}
      </div>
    {% endif %}

  </div>
</div>

<style>
  .template-page-outer {
    padding: 2rem 1.5rem !important;
  }

  @media (min-width: 640px) {
    .template-page-outer {
      padding: 3rem 2rem !important;
    }
  }

  @media (min-width: 768px) {
    .template-page-outer {
      padding: 4rem 4rem !important;
    }
  }

  @media (min-width: 1024px) {
    .template-page-outer {
      padding: 4rem 8rem !important;
    }
  }

  /* Page Title */
  .template-page-outer .page-title {
    font-family: Georgia, serif !important;
    font-size: 1.875rem !important;
    font-weight: 400 !important;
    color: #1a1a1a !important;
    margin-bottom: 2rem !important;
    text-align: left !important;
    letter-spacing: -0.5px !important;
    line-height: 1.1 !important;
  }

  @media (min-width: 768px) {
    .template-page-outer .page-title {
      font-size: 3.5rem !important;
      margin-bottom: 3rem !important;
    }
  }

  /* Contenido Liquid genera h2 y h3 */
  .template-page-outer > div > h2,
  .template-page-outer div h2 {
    font-size: 1.5rem !important;
    font-weight: 600 !important;
    margin: 3rem 0 1.5rem 0 !important;
    color: #D4A574 !important;
    font-family: Georgia, serif !important;
    border-bottom: 1px solid #ddd !important;
    padding-bottom: 1rem !important;
  }

  @media (min-width: 768px) {
    .template-page-outer > div > h2,
    .template-page-outer div h2 {
      font-size: 1.875rem !important;
    }
  }

  .template-page-outer > div > h3,
  .template-page-outer div h3 {
    font-size: 1.25rem !important;
    font-weight: 600 !important;
    margin: 2rem 0 1rem 0 !important;
    color: #D4A574 !important;
    font-family: Georgia, serif !important;
  }

  @media (min-width: 768px) {
    .template-page-outer > div > h3,
    .template-page-outer div h3 {
      font-size: 1.5rem !important;
    }
  }

  .template-page-outer p {
    margin-bottom: 1.25rem !important;
    line-height: 1.8 !important;
    color: #555 !important;
    text-align: justify !important;
  }

  .template-page-outer a {
    color: #D4A574 !important;
  }

  .template-page-outer a:hover {
    color: #B89872 !important;
  }

  .template-page-outer ul,
  .template-page-outer ol {
    margin-left: 1.5rem;
    margin-bottom: 1.25rem;
  }

  @media (min-width: 768px) {
    .template-page-outer ul,
    .template-page-outer ol {
      margin-left: 2rem;
    }
  }

  .template-page-outer li {
    color: #555;
    margin-bottom: 0.75rem;
  }
</style>

{% schema %}
{
  "name": "Page Template",
  "settings": []
}
{% endschema %}
