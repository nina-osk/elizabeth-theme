<div class="page-template">
  <div class="page-template__wrapper">
    <div class="page-template__container max-w-4xl mx-auto px-4 md:px-6 lg:px-8 py-16 md:py-20 lg:py-24">
      
      {% if page.title %}
        <h1 class="page-template__title" style="font-family: Georgia, serif; font-size: 3.5rem; font-weight: 400; color: #1a1a1a; margin-bottom: 3rem; text-align: left; letter-spacing: -0.5px; line-height: 1.1;">
          {{ page.title }}
        </h1>
      {% endif %}

      {% if page.content %}
        <div class="page-template__content" style="font-size: 1.0625rem; line-height: 1.8; color: #555;">
          {{ page.content }}
        </div>
      {% endif %}

    </div>
  </div>
</div>

<style>
  .page-template {
    width: 100%;
    background-color: #F5F1E8;
    min-height: 100%;
  }

  .page-template__wrapper {
    width: 100%;
    background-color: #F5F1E8;
    padding-top: 0;
    padding-bottom: 6rem;
  }

  .page-template__container {
    width: 100%;
    background-color: #F5F1E8;
  }

  .page-template__title {
    margin-bottom: 2rem;
  }

  .page-template__content {
    word-break: break-word;
    background-color: transparent;
  }

  .page-template__content h2 {
    font-size: 1.875rem;
    font-weight: 600;
    margin: 2rem 0 1rem;
    color: #1a1a1a;
    font-family: Georgia, serif;
  }

  .page-template__content h3 {
    font-size: 1.5rem;
    font-weight: 600;
    margin: 1.5rem 0 0.75rem;
    color: #1a1a1a;
    font-family: Georgia, serif;
  }

  .page-template__content p {
    margin-bottom: 1rem;
    color: #555;
  }

  .page-template__content a {
    color: #D4A574;
    text-decoration: none;
    transition: color 0.3s ease;
  }

  .page-template__content a:hover {
    color: #B89872;
    text-decoration: underline;
  }

  .page-template__content ul,
  .page-template__content ol {
    margin: 1rem 0 1rem 2rem;
  }

  .page-template__content li {
    margin-bottom: 0.5rem;
    color: #555;
  }
</style>

{% schema %}
{
  "name": "Page Template",
  "settings": []
}
{% endschema %}
