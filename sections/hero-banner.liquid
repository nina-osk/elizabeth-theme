<div style="width: 100%; background-color: #AFC4AE; display: flex; flex-direction: column; position: relative; overflow: visible;" class="hero-wrapper">
  <!-- Card Overlay Modal -->
  <div class="card-overlay" id="cardOverlay">
    <button class="card-close-btn" id="cardCloseBtn">×</button>
    <div class="expanded-card-container" id="expandedCardContainer">
      <img id="expandedCardImage" class="expanded-card-image" src="" alt="Expanded View" width="600" height="400">
      <div class="expanded-card-content">
        <h3 id="expandedCardTitle">Joyería Exclusiva</h3>
        <p id="expandedCardDescription">Descubre la belleza y elegancia de nuestras joyas diseñadas especialmente para ti.</p>
      </div>
    </div>
  </div>
  
  <!-- Hero Banner with Images -->
  <div class="hero-header-banner" style="position: relative; width: 100%; display: flex; align-items: flex-end; overflow: hidden; min-height: 400px;">
    
    <!-- Images Container -->
    <div class="hero-images-row" style="display: flex; width: 100%; height: 100%; position: absolute; top: 0; left: 0;">
      {% assign images = (1..4) %}
      {% assign fallback_images = 'https://cdn.shopify.com/s/files/1/0760/2697/0309/files/ModeloCloseUp-Aretes_Oro_9K-_Vera.png?v=1769442279|https://cdn.shopify.com/s/files/1/0760/2697/0309/files/ModeloRight-Aretes_-OroBlanco9K-Aura.png?v=1770041849|https://cdn.shopify.com/s/files/1/0760/2697/0309/files/ModeloFront-Aretes_Oro_9K-_Vera.png?v=1770041814|https://cdn.shopify.com/s/files/1/0760/2697/0309/files/ModeloCloseUp-Aretes_-OroBlanco9K-Aura.png?v=1770041849' | split: '|' %}
      
      {% for i in images %}
        {% assign prod_key = 'category_' | append: i | append: '_product' %}
        {% assign prod = section.settings[prod_key] %}
        {% assign fallback_url = fallback_images[forloop.index0] %}
        
        <img 
          src="{% if prod != blank and prod.featured_image %}{{ prod.featured_image | image_url: width: 600 }}{% else %}{{ fallback_url }}{% endif %}" 
          alt="{% if prod != blank %}{{ prod.title }}{% else %}Model {{ i }}{% endif %}" 
          class="hero-card hero-banner-img"
          width="400"
          height="600"
          loading="lazy"
          style="flex: 1; object-fit: cover; height: 100%;"
        />
      {% endfor %}
    </div>

    <!-- Text Overlay Bottom Left -->
    <div class="hero-text-overlay" style="position: absolute; bottom: 0; left: 0; z-index: 10; padding: 3rem 2rem 2rem; max-width: 50%;">
      <p style="font-size: 1.5rem; font-weight: 400; color: white; margin: 0; font-style: italic; font-family: Georgia, serif; line-height: 1.4;">
        {{ section.settings.subtitle }}<br>
        <span style="font-style: italic;">{{ section.settings.title_part2 }}</span>
      </p>
    </div>
  </div>
    <div style="max-width: 900px; margin: 0 auto; text-align: center;">

      <!-- Title Part 2 WITH GIF Background -->
      <div class="hero-video-container" style="display: none;">
        <!-- Video Background -->
        <video 
          class="hero-gif-background visible"
          id="hero-background-video"
          width="1200"
          height="800"
          style="position: absolute; top: 0; left: 0; width: 100%; height: 100%; object-fit: cover; z-index: 0; pointer-events: none;"
          muted="muted"
          loop
          playsinline
          webkit-playsinline="webkit-playsinline"
          preload="auto"
        >
          <source src="https://cdn.shopify.com/videos/c/o/v/9c41e91edb6c4a5b9de641fe09c6914c.mp4" type="video/mp4">
        </video>
        
        <!-- Title Part 1 - Inside Video Container as Overlay -->
        <h1 style="font-family: Georgia, serif; line-height: 1.15; color: white; position: absolute; top: 20%; left: 50%; transform: translate(-50%, -50%); width: 100%; z-index: 1; margin: 0; text-shadow: 2px 2px 4px rgba(0, 0, 0, 0.3);">
          <span style="display: block; font-size: 6.5rem; font-weight: 400; font-style: italic; opacity: 1;" class="hero-title-part1">{{ section.settings.title_part1 }}</span>
        </h1>
        
        <!-- Title Part 2 -->
        <h1 style="font-family: Georgia, serif; line-height: 1.15; color: #2d2d2d; position: absolute; top: 80%; left: 50%; transform: translate(-50%, -50%); width: 100%; z-index: 1; margin: 0;">
          <span style="display: block; font-size: 3.5rem; font-style: italic; color: white; font-weight: 400; opacity: 1;" class="hero-title-part2">{{ section.settings.title_part2 }}</span>
        </h1>
      </div>
      
      <!-- Buttons -->
      <div style="display: flex; gap: 1rem; justify-content: center; align-items: center; flex-wrap: wrap; opacity: 1; margin-top: 3rem; margin-bottom: 3rem; position: relative; z-index: 15; pointer-events: auto;" class="hero-buttons">
        <a href="{{ section.settings.button1_link }}" class="hero-btn hero-btn-active">
          {{ section.settings.button1_text }}
        </a>
        <a href="{{ section.settings.button2_link }}" class="hero-btn hero-btn-outline">
          {{ section.settings.button2_text }}
        </a>
      </div>

      <!-- Description -->
      <p style="font-size: 1.25rem; color: #000000; line-height: 1.7; max-width: 650px; margin: 0 auto; opacity: 1; font-style: italic;" class="hero-description">
        {{ section.settings.description }}
      </p>

      <!-- Description 2 -->
      <p style="font-size: 1.25rem; color: #000000; line-height: 1.7; max-width: 650px; margin: 2rem auto 0; opacity: 1; font-style: italic;" class="hero-description-2">
        {{ section.settings.description_2 }}
      </p>

    </div>
</div>

