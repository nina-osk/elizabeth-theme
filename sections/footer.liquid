<footer class="footer-main">
  {% liquid 
    if section.settings.footer_menu.links == blank
      assign footer_menu_links = linklists[section.settings.footer_menu].links
    else
      assign footer_menu_links = section.settings.footer_menu.links
    endif
  %}
  <div class="footer-container">
    
    <!-- Header Section -->
    <div class="footer-header">
      <h2 class="footer-title">
        {{ section.settings.header_title | default: "Bienvenida a un lujo accesible, inclusivo y real." }}
      </h2>
      <p class="footer-subtitle">
        {{ section.settings.header_subtitle | default: "Un lujo que se adapta a tu vida. Un lujo que te acompaña." }}
      </p>
    </div>

    <!-- Main Footer Content -->
    <div class="footer-content">
      <div class="footer-grid">
        
        <!-- Brand Column -->
        <div class="footer-column footer-brand-column">
          <a href="{{ routes.root_url }}" class="footer-logo-link">
            {% if section.settings.footer_logo != blank %}
              <img
                src="{{ section.settings.footer_logo | image_url: width: 400 }}"
                alt="{{ shop.name }}"
                width="200"
                height="100"
                loading="lazy"
                class="footer-logo-img"
              >
            {% else %}
              <span class="footer-logo-fallback">{{ shop.name }}</span>
            {% endif %}
          </a>
        </div>

        <!-- Navigation Column (from menu) -->
        <div class="footer-column">
          <h3 class="footer-column-title">
            {{ section.settings.explore_title | default: "EXPLORAR" }}
          </h3>
          <nav class="footer-nav">
            {% for link in footer_menu_links %}
              <a href="{{ link.url }}" class="footer-link">
                {{ link.title }}
              </a>
            {% endfor %}
          </nav>
        </div>

        <!-- Munier Column -->
        <div class="footer-column">
          <h3 class="footer-column-title">
            {{ section.settings.menu_title | default: "MUNIER" }}
          </h3>
          <nav class="footer-nav">
            <a href="/pages/contact" class="footer-link">
              Contacto
            </a>
            <a href="/pages/costo-del-envio" class="footer-link">
              Costo de Envío
            </a>
            <a href="/pages/page-politica-devoluciones            shopify auth logout
            shopify auth login --store nina-oska.myshopify.com            shopify auth logout
            shopify auth login --store nina-oska.myshopify.com" class="footer-link">
              Política de Devoluciones y Cambios
            </a>
            <a href="https://wa.me/50768697555" target="_blank" class="footer-link">
              WhatsApp Business
            </a>
          </nav>
        </div>

      </div>
    </div>
    
    <!-- Bottom Bar -->
    <div class="footer-bottom">
      <p class="footer-info">
        {{ section.settings.info_text | default: "Joyería Panameña • Oro 9K & 18K • Diamantes de Laboratorio" }}
      </p>
      <p class="footer-legal">
        {{ section.settings.legal_text_1 | default: "Maison Myck, S. A." }}
      </p>
      <p class="footer-legal">
        {{ section.settings.legal_text_2 | default: "Munier Jewelry" }}
      </p>
    </div>

  </div>
</footer>

<style>
/* ========================================
   FOOTER BASE STYLES
   ======================================== */
.footer-main {
  background-color: #AFC4AE;
  color: #2d2d2d;
  overflow-x: hidden;
}

.footer-container {
  max-width: 1280px;
  margin: 0 auto;
  padding: 0 1rem;
  width: 100%;
  box-sizing: border-box;
}

/* ========================================
   HEADER SECTION
   ======================================== */
.footer-header {
  padding-top: 2.5rem;
  padding-bottom: 2rem;
  text-align: center;
}

.footer-title {
  font-family: Georgia, serif;
  font-size: 1.25rem;
  font-weight: 400;
  color: #2d2d2d;
  margin-bottom: 0.75rem;
  line-height: 1.4;
}

.footer-subtitle {
  font-family: Georgia, serif;
  font-size: 0.95rem;
  font-style: italic;
  color: #5a7058;
  margin: 0;
}

/* ========================================
   MAIN CONTENT
   ======================================== */
.footer-content {
  padding-top: 2rem;
  padding-bottom: 2rem;
}

.footer-grid {
  display: grid;
  grid-template-columns: 1fr;
  gap: 2rem;
}

.footer-column {
  text-align: center;
}

.footer-column-title {
  font-size: 0.7rem;
  font-weight: 600;
  color: #5a7058;
  margin-bottom: 1rem;
  letter-spacing: 0.1em;
}

.footer-brand-column {
  display: flex;
  align-items: center;
  justify-content: center;
}

.footer-logo-link {
  display: inline-block;
  text-decoration: none;
}

.footer-logo-img {
  height: auto;
  width: auto;
  max-height: 4rem;
  max-width: 200px;
}

.footer-logo-fallback {
  font-family: Georgia, serif;
  font-size: 1.25rem;
  letter-spacing: 0.3em;
  color: #2d2d2d;
}

.footer-nav {
  display: flex;
  flex-direction: column;
  gap: 0.65rem;
}

.footer-link {
  font-size: 0.9rem;
  color: #3d523c;
  text-decoration: none;
  transition: color 0.2s;
}

.footer-link:hover {
  color: #2d2d2d;
}

/* ========================================
   BOTTOM BAR
   ======================================== */
.footer-bottom {
  border-top: 1px solid rgba(93, 112, 88, 0.3);
  padding-top: 1.5rem;
  padding-bottom: 1.5rem;
  text-align: center;
}

.footer-copyright {
  font-size: 0.8rem;
  color: #5a7058;
  margin-bottom: 0.5rem;
}

.footer-info {
  font-size: 0.75rem;
  color: #6b8068;
  margin-bottom: 0.25rem;
}

.footer-legal {
  font-size: 0.7rem;
  color: #6b8068;
  margin-bottom: 0.25rem;
}

/* ========================================
   TABLET (640px+)
   ======================================== */
@media (min-width: 640px) {
  .footer-container {
    padding: 0 1.5rem;
  }
  
  .footer-header {
    padding-top: 3rem;
    padding-bottom: 2.5rem;
  }
  
  .footer-title {
    font-size: 1.75rem;
  }
  
  .footer-subtitle {
    font-size: 1rem;
  }
  
  .footer-grid {
    grid-template-columns: repeat(2, 1fr);
    gap: 2.5rem;
  }
  
  .footer-column:first-child {
    grid-column: 1 / -1;
  }
}

/* ========================================
   DESKTOP (768px+)
   ======================================== */
@media (min-width: 768px) {
  .footer-container {
    padding: 0 2rem;
  }
  
  .footer-header {
    padding-top: 4rem;
    padding-bottom: 3rem;
  }
  
  .footer-title {
    font-size: 2.5rem;
    margin-bottom: 1rem;
    line-height: 1.3;
  }
  
  .footer-subtitle {
    font-size: 1.125rem;
  }
  
  .footer-content {
    padding-top: 3rem;
    padding-bottom: 3rem;
  }
  
  .footer-grid {
    grid-template-columns: repeat(3, 1fr);
    gap: 4rem;
  }
  
  .footer-column {
    text-align: left;
  }
  
  .footer-column:first-child {
    grid-column: auto;
  }
  
  .footer-column-title {
    font-size: 0.75rem;
    margin-bottom: 1.5rem;
  }
  
  .footer-brand-column {
    justify-content: flex-start;
  }
  
  .footer-logo-img {
    max-height: 5rem;
    max-width: 240px;
  }
  
  .footer-nav {
    gap: 0.75rem;
  }
  
  .footer-link {
    font-size: 0.9375rem;
  }
  
  .footer-bottom {
    padding-top: 2rem;
    padding-bottom: 2rem;
  }
  
  .footer-copyright {
    font-size: 0.875rem;
  }
  
  .footer-info {
    font-size: 0.8125rem;
  }

  .footer-legal {
    font-size: 0.75rem;
  }
}
</style>

{% schema %}
{
  "name": "Footer",
  "settings": [
    {
      "type": "header",
      "content": "Encabezado del Footer"
    },
    {
      "type": "text",
      "id": "header_title",
      "label": "Título principal",
      "default": "Bienvenida a un lujo accesible, inclusivo y real."
    },
    {
      "type": "text",
      "id": "header_subtitle",
      "label": "Subtítulo",
      "default": "Un lujo que se adapta a tu vida. Un lujo que te acompaña."
    },
    {
      "type": "header",
      "content": "Logo del Footer"
    },
    {
      "type": "image_picker",
      "id": "footer_logo",
      "label": "Logo del Footer"
    },
    {
      "type": "header",
      "content": "Columna Explorar (Centro)"
    },
    {
      "type": "link_list",
      "id": "footer_menu",
      "label": "Menú de navegación",
      "default": "main-menu-1"
    },
    {
      "type": "text",
      "id": "explore_title",
      "label": "Título de Explorar",
      "default": "EXPLORAR"
    },
    {
      "type": "header",
      "content": "Columna del Menú (Derecha)"
    },
    {
      "type": "text",
      "id": "menu_title",
      "label": "Título del menú",
      "default": "MUNIER"
    },
    {
      "type": "header",
      "content": "Pie del Footer"
    },
    {
      "type": "text",
      "id": "info_text",
      "label": "Texto de Información",
      "default": "Joyería Panameña • Oro 9K & 18K • Diamantes de Laboratorio"
    },
    {
      "type": "text",
      "id": "legal_text_1",
      "label": "Texto Legal 1",
      "default": "Maison Myck, S. A."
    },
    {
      "type": "text",
      "id": "legal_text_2",
      "label": "Texto Legal 2",
      "default": "Munier Jewelry"
    }
  ]
}
{% endschema %}
