<div class="relative py-16 md:py-24 px-4 overflow-hidden video-with-text" style="min-height: 600px; display: flex; flex-direction: column; position: relative;">
    <!-- Video de fondo -->
    <div class="absolute inset-0 w-full h-full overflow-hidden" style="z-index: 0; position: absolute; top: 0; left: 0;">
        {% if section.settings.video_file != blank %}
            <video 
                class="absolute top-0 left-0 w-full h-full object-cover"
                autoplay
                muted
                loop
                playsinline
                webkit-playsinline
                x5-playsinline
                preload="metadata"
                id="background-video"
                controls="false"
                {% if section.settings.video_poster %}poster="{{ section.settings.video_poster | image_url: width: 1920 }}"{% endif %}
                style="width: 100%; height: 100%; object-fit: cover; position: absolute; top: 0; left: 0; z-index: 1; -webkit-user-select: none; user-select: none;">
                <source src="{{ section.settings.video_file }}" type="video/mp4">
                Tu navegador no soporta video HTML5.
            </video>
            
            <div class="absolute inset-0 bg-black" style="opacity: 0.4; z-index: 2; pointer-events: none;"></div>
        {% elsif section.settings.video_url != blank %}
            {% assign video_url = section.settings.video_url %}
            {% if video_url contains 'youtube.com' or video_url contains 'youtu.be' %}
                {% if video_url contains 'watch?v=' %}
                    {% assign video_id = video_url | split: 'watch?v=' | last | split: '&' | first %}
                {% elsif video_url contains 'youtu.be/' %}
                    {% assign video_id = video_url | split: 'youtu.be/' | last | split: '?' | first %}
                {% else %}
                    {% assign video_id = video_url | split: 'embed/' | last | split: '?' | first %}
                {% endif %}
                <iframe 
                    class="absolute top-0 left-0 w-full h-full"
                    src="https://www.youtube.com/embed/{{ video_id }}?autoplay=1&mute=1&loop=1&controls=0&playlist={{ video_id }}&playsinline=1"
                    frameborder="0"
                    allow="autoplay; encrypted-media; fullscreen"
                    allowfullscreen
                    style="pointer-events: none; width: 100%; height: 100%; z-index: 1;">
                </iframe>
                
                <div class="absolute inset-0 bg-black" style="opacity: 0.4; z-index: 2; pointer-events: none;"></div>
            {% elsif video_url contains 'vimeo.com' %}
                {% assign video_id = video_url | split: 'vimeo.com/' | last | split: '/' | first %}
                <iframe 
                    class="absolute top-0 left-0 w-full h-full"
                    src="https://player.vimeo.com/video/{{ video_id }}?autoplay=1&muted=1&loop=1&background=1&controls=0"
                    frameborder="0"
                    allow="autoplay; fullscreen; picture-in-picture"
                    allowfullscreen
                    style="pointer-events: none; width: 100%; height: 100%; z-index: 1;">
                </iframe>
                
                <div class="absolute inset-0 bg-black" style="opacity: 0.4; z-index: 2; pointer-events: none;"></div>
            {% endif %}
        {% else %}
            <div class="absolute top-0 left-0 w-full h-full bg-gray-900"></div>
        {% endif %}
    </div>

    <!-- Contenido sobre el video -->
    <div class="max-w-7xl mx-auto relative flex-1" style="z-index: 10; display: flex; align-items: flex-end; width: 100%;">
        <div style="max-width: 600px; padding: 0 2rem 1.5rem;">
            <p style="font-family: Georgia, serif; font-size: 2rem; line-height: 1.6; color: white; font-weight: 400; text-shadow: 2px 2px 8px rgba(0, 0, 0, 0.4);" class="video-overlay-text">
                {{ section.settings.overlay_text_line1 | default: 'Joyas que se mueven contigo,' }}<br>
                {{ section.settings.overlay_text_line2 | default: 'desde lo cotidiano a lo inolvidable' }}
            </p>
        </div>
    </div>
</div>

<style>
    .video-with-text {
        position: relative;
        display: flex;
        flex-direction: column;
    }
    
    .video-with-text video {
        width: 100%;
        height: 100%;
        object-fit: cover;
        display: block;
    }
    
    .video-with-text iframe {
        width: 100%;
        height: 100%;
        display: block;
    }
    
    @media (max-width: 640px) {
        .video-with-text {
            min-height: 300px !important;
        }
        .video-overlay-text {
            font-size: 1.25rem !important;
        }
    }
    
    @media (min-width: 641px) and (max-width: 1024px) {
        .video-with-text {
            min-height: 450px !important;
        }
    }
    
    @media (min-width: 1025px) {
        .video-with-text {
            min-height: 600px !important;
        }
    }
</style>

<script>
// Inicializar video con política de autoplay mejorada para iOS/Safari
(function() {
    const videoElement = document.querySelector('#background-video');
    
    if (videoElement) {
        // Asegurar que está muteado (requerido para autoplay)
        videoElement.muted = true;
        videoElement.defaultMuted = true;
        
        // Establecer atributos playsinline correctamente
        videoElement.playsinline = true;
        videoElement.setAttribute('webkit-playsinline', 'true');
        videoElement.setAttribute('x5-playsinline', 'true');
        
        // Log inicial
        console.log('🎬 Video MP4 inicializado:', {
            videoFile: videoElement.src || videoElement.querySelector('source')?.src,
            muted: videoElement.muted,
            playsinline: videoElement.playsinline
        });
        
        // Forzar carga del video
        videoElement.load();
        console.log('📦 Cargando video desde:', videoElement.querySelector('source')?.src);
        
        // Función para intentar reproducir
        const playVideo = () => {
            console.log('▶️  Intentando reproducir... Estado:', videoElement.readyState);
            
            const playPromise = videoElement.play();
            if (playPromise !== undefined) {
                playPromise
                    .then(() => {
                        console.log('✅ Video reproduciendo correctamente');
                    })
                    .catch(error => {
                        console.warn('⚠️  Error de reproducción:', error.message);
                        // Fallback: asegurar visibilidad
                        videoElement.style.display = 'block';
                        videoElement.style.visibility = 'visible';
                    });
            }
        };
        
        // Intentar reproducir inmediatamente si ya está listo
        if (videoElement.readyState >= 3) {
            console.log('⚡ Video ya cargado, reproduciendo inmediatamente');
            playVideo();
        }
        
        // Escuchadores para eventos de carga
        videoElement.addEventListener('canplay', () => {
            console.log('🎥 Video listo para reproducir (canplay)');
            playVideo();
        }, { once: true });
        
        videoElement.addEventListener('loadedmetadata', () => {
            console.log('📹 Metadatos cargados');
            playVideo();
        }, { once: true });
        
        videoElement.addEventListener('loadeddata', () => {
            console.log('💾 Datos de video cargados');
            playVideo();
        }, { once: true });
        
        // Detectar error en carga
        videoElement.addEventListener('error', (e) => {
            console.error('❌ Error cargando video:', {
                errorCode: e.target.error?.code,
                errorMsg: e.target.error?.message,
                src: e.target.src || e.target.querySelector('source')?.src
            });
        });
        
        // Fallback de timeout
        setTimeout(() => {
            if (videoElement.readyState < 2) {
                console.warn('⏱️  Video no cargó en 5 segundos');
                console.warn('URL del video:', videoElement.querySelector('source')?.src);
                console.warn('¿La URL es accesible? Verifica en Settings > Files de Shopify');
            }
        }, 5000);
    } else {
        console.error('❌ Elemento de video #background-video no encontrado');
    }
})();
</script>

{% schema %}
{
    "name": "Video with Text",
    "settings": [
        {
            "type": "text",
            "id": "overlay_text_line1",
            "default": "Joyas que se mueven contigo,",
            "label": "Texto sobre el video - Línea 1"
        },
        {
            "type": "text",
            "id": "overlay_text_line2",
            "default": "desde lo cotidiano a lo inolvidable",
            "label": "Texto sobre el video - Línea 2"
        },
        {
            "type": "text",
            "id": "video_url",
            "label": "URL del video (YouTube o Vimeo)",
            "info": "Ejemplo: https://www.youtube.com/embed/VIDEO_ID"
        },
        {
            "type": "text",
            "id": "video_file",
            "label": "URL del archivo de video (MP4)",
            "info": "1. Ve a Settings > Files en tu admin de Shopify. 2. Sube tu video .mp4. 3. Haz clic en el archivo subido para abrir. 4. Copia la URL que aparece en la barra de direcciones. 5. Pega esa URL aquí."
        },
        {
            "type": "image_picker",
            "id": "video_poster",
            "label": "Imagen de portada del video"
        }
    ],
    "presets": [
        {
            "name": "Video with Text"
        }
    ]
}
{% endschema %}
