<div class="product-card bg-white rounded-lg overflow-hidden transition-all duration-300 w-full" data-current-image="0">
    <!-- Product Image with Actions -->
    <div class="relative bg-neutral-100 group product-image-container">
        <a href="{{ product.url }}" class="block w-full h-full collection-product-link" data-product-url="{{ product.url }}" data-collection-handle="{{ collection_handle }}">
            <!-- Image Display Container -->
            <div class="product-image-display w-full h-full">
                {% if product.featured_image %}
                    <img 
                        class="product-main-image w-full h-full object-cover" 
                        src="{{ product.featured_image | image_url: width: 800 }}" 
                        alt="{{ product.featured_image.alt }}" 
                        width="800" 
                        height="800" 
                        loading="lazy"
                        data-index="0"
                    >
                {% else %}
                    {{ 'product-1' | placeholder_svg_tag: 'w-full h-full object-contain' }}
                {% endif %}
                
                <!-- Hidden images for carousel -->
                {% for media in product.media offset: 1 limit: 2 %}
                    <img 
                        class="product-carousel-image w-full h-full object-cover hidden" 
                        src="{{ media | image_url: width: 800 }}" 
                        alt="{{ media.alt }}" 
                        width="800" 
                        height="800" 
                        loading="lazy"
                        data-index="{{ forloop.index }}"
                    >
                {% endfor %}
            </div>
        </a>
        
        <!-- Actions Bar at Bottom of Image -->
        <div class="absolute bottom-4 left-0 right-0 bg-transparent p-4 opacity-0 group-hover:opacity-100 transition-opacity duration-300">
            <div class="flex items-center justify-between gap-2">
                <!-- Add to Cart Button -->
                {% assign current_variant = product.selected_or_first_available_variant %}
                <form action="{{ routes.cart_add_url }}" method="post" class="flex-1" data-product-form>
                    <input type="hidden" name="id" value="{{ current_variant.id }}">
                    <button 
                        type="submit"
                        class="w-full bg-black text-white text-center py-2.5 px-4 text-xs font-semibold tracking-wider uppercase hover:bg-neutral-800 transition-colors"
                    >
                        AGREGAR AL CARRITO
                    </button>
                </form>
                
                <!-- Wishlist Icon -->
                <button 
                    class="flex items-center justify-center w-10 h-10 hover:bg-neutral-100 rounded transition-colors wishlist-btn" 
                    aria-label="Add to wishlist"
                    data-product-id="{{ product.id }}"
                    data-product-handle="{{ product.handle }}"
                    data-product-title="{{ product.title }}"
                    data-product-image="{{ product.featured_image | image_url: width: 300 }}"
                    data-product-price="{{ product.price | money }}"
                    onclick="toggleWishlist(this, event)"
                >
                    <svg class="w-5 h-5 wishlist-icon" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z"/>
                    </svg>
                </button>
            </div>
        </div>
        
        <!-- Image Navigation Arrows -->
        {% if product.media.size > 1 %}
            <button class="absolute left-2 top-1/2 -translate-y-1/2 bg-white/80 hover:bg-white p-2 rounded-full transition-all opacity-0 group-hover:opacity-100" aria-label="Previous image" onclick="previousProductImage(this, event)">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7"/>
                </svg>
            </button>
            <button class="absolute right-2 top-1/2 -translate-y-1/2 bg-white/80 hover:bg-white p-2 rounded-full transition-all opacity-0 group-hover:opacity-100" aria-label="Next image" onclick="nextProductImage(this, event)">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7"/>
                </svg>
            </button>
        {% endif %}
        
        <!-- Image Pagination Dots -->
        {% if product.media.size > 1 %}
            <div class="absolute bottom-4 left-0 right-0 flex justify-center gap-1.5 image-dots" data-product-id="{{ product.id }}">
                {% assign max_images = product.media.size | at_most: 3 %}
                {% for i in (1..max_images) %}
                    <button class="w-2 h-2 rounded-full image-dot {% if i == 1 %}bg-black{% else %}bg-neutral-400{% endif %}" data-index="{{ i | minus: 1 }}" onclick="goToProductImage(this, event)"></button>
                {% endfor %}
            </div>
        {% endif %}
    </div>
    
    <!-- Product Info -->
    <div class="p-2 md:p-4 text-left">
        <!-- Product Title -->
        <a href="{{ product.url }}" class="block text-neutral-900 font-normal text-sm md:text-base mb-1 md:mb-2 hover:text-neutral-700 transition-colors line-clamp-2 collection-product-link" data-product-url="{{ product.url }}" data-collection-handle="{{ collection_handle }}">
            {{ product.title }}
        </a>
        
        <!-- Product Price -->
        <p class="text-neutral-900 font-normal text-sm md:text-base">
            {% assign variant = product.selected_or_first_available_variant %}
            {% if variant.compare_at_price > variant.price %}
                <span class="text-neutral-500 line-through mr-2">{{ variant.compare_at_price | money_with_currency }}</span>
                <span class="text-red-600">{{ variant.price | money_with_currency }}</span>
            {% elsif product.price_varies %}
                Desde {{ product.price_min | money_with_currency }}
            {% else %}
                {{ variant.price | money_with_currency }}
            {% endif %}
        </p>
    </div>
</div>

<style>
.product-image-container {
    aspect-ratio: 1 / 1;
    min-height: 350px;
}

.hidden {
    display: none !important;
}

/* Mobile - Botón aparece solo on hover */
@media (max-width: 767px) {
    .product-image-container .absolute.bottom-4 {
        background: transparent !important;
        bottom: 1rem !important;
        left: 0 !important;
        right: 0 !important;
        padding: 0 !important;
        opacity: 0 !important;
        transition: opacity 0.3s ease-in-out !important;
        pointer-events: none !important;
    }
    
    .product-image-container:hover .absolute.bottom-4 {
        opacity: 1 !important;
        pointer-events: auto !important;
    }
    
    .product-image-container .absolute.bottom-4 .flex {
        display: flex !important;
        justify-content: center !important;
        padding: 0.75rem !important;
        gap: 0.5rem !important;
    }
    
    .product-image-container button[type="submit"] {
        background: linear-gradient(135deg, #AFC4AE 0%, #9BB49A 100%) !important;
        color: #2d2d2d !important;
        padding: 0.65rem 1rem !important;
        flex: 1 !important;
        font-size: 0.65rem !important;
    }
    
    .product-image-container button[type="submit"]:hover {
        background: linear-gradient(135deg, #9BB49A 0%, #8BA08B 100%) !important;
    }
}

@media (min-width: 480px) {
    .product-image-container {
        min-height: 400px;
    }
}

@media (min-width: 640px) {
    .product-image-container {
        min-height: 450px;
    }
}

@media (min-width: 768px) {
    .product-image-container {
        min-height: auto;
    }
}
</style>

<script>
// Wishlist functionality
function toggleWishlist(button, event) {
  event.preventDefault();
  event.stopPropagation();
  
  const productId = button.getAttribute('data-product-id');
  const productHandle = button.getAttribute('data-product-handle');
  const productTitle = button.getAttribute('data-product-title');
  const productImage = button.getAttribute('data-product-image');
  const productPrice = button.getAttribute('data-product-price');
  
  let wishlist = JSON.parse(localStorage.getItem('munier_wishlist') || '[]');
  
  // Check if product is already in wishlist
  const existingIndex = wishlist.findIndex(item => item.id === productId);
  
  if (existingIndex > -1) {
    // Remove from wishlist
    wishlist.splice(existingIndex, 1);
    button.classList.remove('wishlist-active');
    showNotification('Removido de la lista de deseos');
  } else {
    // Add to wishlist
    wishlist.push({
      id: productId,
      handle: productHandle,
      title: productTitle,
      image: productImage,
      price: productPrice,
      addedAt: new Date().toISOString()
    });
    button.classList.add('wishlist-active');
    showNotification('Agregado a la lista de deseos ❤️');
  }
  
  localStorage.setItem('munier_wishlist', JSON.stringify(wishlist));
  updateWishlistUI();
  
  // Update Shopify metafield if customer is logged in
  syncWishlistToShopifyMetafield(wishlist);
}


// Image navigation for product cards - Cambiar entre imágenes del producto
function changeProductImage(card, direction) {
  if (!card) return;
  
  const allImages = card.querySelectorAll('[data-index]');
  if (allImages.length <= 1) return;
  
  let currentIndex = parseInt(card.getAttribute('data-current-image')) || 0;
  
  // Calcular siguiente índice
  let nextIndex = direction === 'next' ? currentIndex + 1 : currentIndex - 1;
  if (nextIndex >= allImages.length) nextIndex = 0;
  if (nextIndex < 0) nextIndex = allImages.length - 1;
  
  // Ocultar todas las imágenes
  allImages.forEach(img => {
    img.classList.add('hidden');
  });
  
  // Mostrar imagen siguiente
  const nextImage = card.querySelector(`[data-index="${nextIndex}"]`);
  if (nextImage) {
    nextImage.classList.remove('hidden');
    card.setAttribute('data-current-image', nextIndex.toString());
    updateImageDots(card, nextIndex);
    console.log('Imagen actual:', nextIndex);
  }
}

function updateImageDots(card, activeIndex) {
  const dots = card.querySelectorAll('.image-dot');
  dots.forEach((dot, i) => {
    if (i === activeIndex) {
      dot.classList.remove('bg-neutral-400');
      dot.classList.add('bg-black');
    } else {
      dot.classList.remove('bg-black');
      dot.classList.add('bg-neutral-400');
    }
  });
}

function nextProductImage(button, event) {
  event.preventDefault();
  event.stopPropagation();
  
  const card = button.closest('.product-card');
  if (card) changeProductImage(card, 'next');
}

function previousProductImage(button, event) {
  event.preventDefault();
  event.stopPropagation();
  
  const card = button.closest('.product-card');
  if (card) changeProductImage(card, 'prev');
}

function goToProductImage(dot, event) {
  event.preventDefault();
  event.stopPropagation();
  
  const card = dot.closest('.product-card');
  const index = parseInt(dot.getAttribute('data-index'));
  
  if (!card) return;
  
  // Ocultar todas las imágenes
  const allImages = card.querySelectorAll('[data-index]');
  allImages.forEach(img => {
    img.classList.add('hidden');
  });
  
  // Mostrar imagen seleccionada
  const selectedImage = card.querySelector(`[data-index="${index}"]`);
  if (selectedImage) {
    selectedImage.classList.remove('hidden');
    card.setAttribute('data-current-image', index.toString());
    updateImageDots(card, index);
    console.log('Imagen seleccionada:', index);
  }
}

// Show notification
function showNotification(message) {
  const notification = document.createElement('div');
  notification.style.cssText = `
    position: fixed;
    top: 20px;
    right: 20px;
    background: #2d2d2d;
    color: white;
    padding: 1rem 1.5rem;
    border-radius: 0.5rem;
    z-index: 9999;
    animation: slideIn 0.3s ease-out;
  `;
  notification.textContent = message;
  document.body.appendChild(notification);
  
  setTimeout(() => {
    notification.style.animation = 'slideOut 0.3s ease-out';
    setTimeout(() => notification.remove(), 300);
  }, 2000);
}

// Update wishlist UI (highlight hearts if in wishlist)
function updateWishlistUI() {
  const wishlist = JSON.parse(localStorage.getItem('munier_wishlist') || '[]');
  const wishlistIds = new Set(wishlist.map(item => item.id));
  
  document.querySelectorAll('.wishlist-btn').forEach(btn => {
    const productId = btn.getAttribute('data-product-id');
    if (wishlistIds.has(productId)) {
      btn.classList.add('wishlist-active');
      btn.querySelector('.wishlist-icon').setAttribute('fill', 'currentColor');
    } else {
      btn.classList.remove('wishlist-active');
      btn.querySelector('.wishlist-icon').setAttribute('fill', 'none');
    }
  });
}

// Sync with Shopify metafield
function syncWishlistToShopifyMetafield(wishlist) {
  const customerId = '{{ customer.id | escape }}';
  if (!customerId || customerId === '') return;
  
  const mutation = `
    mutation {
      customerUpdate(
        input: {
          id: "gid://shopify/Customer/${customerId}"
          metafields: [
            {
              namespace: "munier"
              key: "wishlist"
              type: "json"
              value: "${JSON.stringify(wishlist).replace(/"/g, '\\"')}"
            }
          ]
        }
      ) {
        customer {
          id
        }
        userErrors {
          field
          message
        }
      }
    }
  `;
  
  fetch('/admin/api/2024-01/graphql.json', {
    method: 'POST',
    headers: {
      'Content-Type': 'application/json',
    },
    body: JSON.stringify({ query: mutation })
  })
  .catch(err => {
    console.warn('Sincronización con Shopify fallida, usando localStorage:', err);
  });
}

// Initialize wishlist UI on page load
document.addEventListener('DOMContentLoaded', updateWishlistUI);

// Add styles for animations
const style = document.createElement('style');
style.textContent = `
  @keyframes slideIn {
    from {
      transform: translateX(400px);
      opacity: 0;
    }
    to {
      transform: translateX(0);
      opacity: 1;
    }
  }
  
  @keyframes slideOut {
    from {
      transform: translateX(0);
      opacity: 1;
    }
    to {
      transform: translateX(400px);
      opacity: 0;
    }
  }
  
  .wishlist-btn.wishlist-active .wishlist-icon {
    fill: #D4A574;
    stroke: #D4A574;
  }
  
  .wishlist-btn:hover {
    background-color: #D4A574 !important;
    color: white;
  }
`;
document.head.appendChild(style);

(function() {
  document.addEventListener('DOMContentLoaded', function() {
    var productLinks = document.querySelectorAll('.collection-product-link');
    console.log('DEBUG: Encontrados', productLinks.length, 'enlaces de producto');
    
    productLinks.forEach(function(link) {
      link.addEventListener('click', function(e) {
        e.preventDefault();
        
        // Opción 1: Obtener del atributo data-collection-handle (para colecciones específicas)
        var collectionHandle = this.getAttribute('data-collection-handle');
        console.log('DEBUG: Collection handle del atributo:', collectionHandle);
        
        // Opción 2: Si está vacío, buscar en el DOM qué colección está visible
        if (!collectionHandle || collectionHandle === '') {
          var activeGroup = document.querySelector('.collection-products-group:not(.hidden)');
          if (activeGroup) {
            collectionHandle = activeGroup.getAttribute('data-collection-handle');
            console.log('DEBUG: Collection handle del DOM activo:', collectionHandle);
          } else {
            var activeBtn = document.querySelector('.collection-filter-btn.active');
            if (activeBtn) {
              collectionHandle = activeBtn.getAttribute('data-collection-handle');
              console.log('DEBUG: Collection handle del botón activo:', collectionHandle);
            }
          }
        }
        
        // Construir la URL de la colección
        var collectionUrl;
        if (collectionHandle && collectionHandle !== '') {
          collectionUrl = '/collections/' + collectionHandle;
        } else {
          collectionUrl = '/collections';
        }
        
        console.log('DEBUG: URL de colección construida:', collectionUrl);
        console.log('DEBUG: Guardando en sessionStorage...');
        sessionStorage.setItem('previousCollectionUrl', collectionUrl);
        console.log('DEBUG: Verificando guardado:', sessionStorage.getItem('previousCollectionUrl'));
        
        var productUrl = this.getAttribute('href') || this.getAttribute('data-product-url');
        console.log('DEBUG: Navegando a:', productUrl);
        window.location.href = productUrl;
      });
    });
  });
})();
</script>